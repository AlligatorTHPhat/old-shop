Table "system_log" {
  "log_id" bigserial [not null]
  "user_id" integer
  "action" varchar(100) [not null]
  "resource_type" varchar(50)
  "resource_id" integer [note: 'Tham chiếu theo resource_type ở mức ứng dụng; không có FOREIGN KEY.']
  "details" text
  "ip_address" varchar(45)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    "action" [name: 'idx_system_log_action', type: btree, note: 'CREATE INDEX idx_system_log_action ON ONLY public.system_log USING btree (action)']
    "created_at" [name: 'idx_system_log_created_at', type: btree, note: 'CREATE INDEX idx_system_log_created_at ON ONLY public.system_log USING btree (created_at)']
    "user_id" [name: 'idx_system_log_user', type: btree, note: 'CREATE INDEX idx_system_log_user ON ONLY public.system_log USING btree (user_id)']
    ("log_id", "created_at") [name: 'system_log_day4_new_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX system_log_day4_new_pkey ON ONLY public.system_log USING btree (log_id, created_at)']
  }

  Note: 'PARTITION BY RANGE (created_at). Partition tháng system_log_YYYYMM và system_log_default. PK(log_id, created_at); log_id riêng lẻ không có UNIQUE. Số partition phụ thuộc dữ liệu và lịch bảo trì.'
}

Table "transaction" {
  "transaction_id" serial [not null]
  "order_id" integer [not null]
  "user_id" integer [not null]
  "payment_method_id" integer [not null]
  "amount" numeric(18,4) [not null]
  "balance_before" numeric(18,4) [default: `0.0000`]
  "balance_after" numeric(18,4) [default: `0.0000`]
  "transaction_status" smallint [not null, default: `0`, note: 'SQL không có CHECK cho trạng thái; chú thích SQL: 0 Pending, 1 Success, 2 Flagged, 3 Fraud, 4 Failed.']
  "fraud_score" numeric(5,2) [default: `0.00`]
  "reference_number" varchar(100)
  "provider_transaction_id" varchar(100)
  "address" text
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [default: `CURRENT_TIMESTAMP`]

  checks {
    `(amount >= (0)::numeric)` [name: 'transaction_amount_check']
  }

  indexes {
    "fraud_score" [name: 'idx_transaction_fraud_score', type: btree, note: 'CREATE INDEX idx_transaction_fraud_score ON public.transaction USING btree (fraud_score)']
    "order_id" [name: 'idx_transaction_order', type: btree, note: 'CREATE INDEX idx_transaction_order ON public.transaction USING btree (order_id)']
    "transaction_status" [name: 'idx_transaction_status', type: btree, note: 'CREATE INDEX idx_transaction_status ON public.transaction USING btree (transaction_status)']
    "user_id" [name: 'idx_transaction_user', type: btree, note: 'CREATE INDEX idx_transaction_user ON public.transaction USING btree (user_id)']
    "transaction_id" [name: 'transaction_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX transaction_pkey ON public.transaction USING btree (transaction_id)']
    "reference_number" [name: 'transaction_reference_number_key', unique, type: btree, note: 'CREATE UNIQUE INDEX transaction_reference_number_key ON public.transaction USING btree (reference_number)']
  }
}

Table "user_core" {
  "user_id" serial [not null]
  "username" varchar(50) [not null]
  "email" varchar(100) [not null]
  "is_active" boolean [not null, default: `true`]
  "is_deleted" boolean [not null, default: `false`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp
  "last_login" timestamp
  "email_verified" boolean [not null, default: `false`]
  "trust_score" numeric(5,2) [default: `0.0`]

  indexes {
    "created_at" [name: 'idx_user_created_at', type: btree, note: 'CREATE INDEX idx_user_created_at ON public.user_core USING btree (created_at)']
    "email" [name: 'idx_user_email_active', type: btree, note: 'CREATE UNIQUE INDEX idx_user_email_active ON public.user_core USING btree (email) WHERE (is_deleted = false)']
    "email_verified" [name: 'idx_user_email_verified', type: btree, note: 'CREATE INDEX idx_user_email_verified ON public.user_core USING btree (email_verified) WHERE (is_deleted = false)']
    "is_active" [name: 'idx_user_is_active', type: btree, note: 'CREATE INDEX idx_user_is_active ON public.user_core USING btree (is_active) WHERE (is_deleted = false)']
    "username" [name: 'idx_user_username_active', type: btree, note: 'CREATE UNIQUE INDEX idx_user_username_active ON public.user_core USING btree (username) WHERE (is_deleted = false)']
    "email" [name: 'user_email_key', unique, type: btree, note: 'CREATE UNIQUE INDEX user_email_key ON public.user_core USING btree (email)']
    "user_id" [name: 'user_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX user_pkey ON public.user_core USING btree (user_id)']
    "username" [name: 'user_username_key', unique, type: btree, note: 'CREATE UNIQUE INDEX user_username_key ON public.user_core USING btree (username)']
  }

  Note: 'Đổi tên từ "user" bởi migration 003. Tất cả FK cũ tự trỏ tới user_core; tên constraint/index có thể vẫn mang tiền tố user_. users_full JOIN user_core/user_profile/user_secret/user_wallet, không có bảng "user" sau migration.'
}

Table "user_profile" {
  "user_id" integer [not null]

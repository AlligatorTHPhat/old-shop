// Nguồn: SQL trong repository; đối chiếu qua catalog PostgreSQL 16 dựng tạm.
// Các bảng vật lý sau migration; không dùng ORM làm nguồn schema.
Project oldshop_distributed {
  database_type: 'PostgreSQL'
  Note: 'Schema PostgreSQL suy ra từ database/init.sql và toàn bộ migration 001–007; không phải snapshot database đang chạy. Gồm bảng nghiệp vụ, bảng vận hành và schema_migrations do backend/scripts/migrate.py tạo. Chỉ vẽ FK được SQL khai báo. users_full là view JOIN chỉ đọc, không phải bảng. Các partition được biểu diễn bằng bảng cha; xem ghi chú từng bảng. Index có điều kiện, GIN và thứ tự sắp xếp được giữ bằng SQL trong note vì DBML không biểu diễn đầy đủ. Bản cho mỗi site sau database/distributed/01_site_schema.sql: thêm site_config, distributed_installation, seller_site và product.site_id. Hai site có cùng cấu trúc. site_identity là view. site_b.* là foreign tables; v_product, v_product_image, v_category, v_seller_site, v_site_health là views trên site A, không phải bảng hay FK bổ sung. Trigger enforce_product_site/enforce_image_site kiểm tra site, ID lẻ ở A/chẵn ở B và không cho đổi ownership.'
}

Table "category" {
  "category_id" serial [not null]
  "name" varchar(100) [not null]
  "description" text
  "parent_id" integer
  "is_active" boolean [not null, default: `true`]
  "is_deleted" boolean [not null, default: `false`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp

  indexes {
    "name" [name: 'category_name_key', unique, type: btree, note: 'CREATE UNIQUE INDEX category_name_key ON public.category USING btree (name)']
    "category_id" [name: 'category_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX category_pkey ON public.category USING btree (category_id)']
    "created_at" [name: 'idx_category_created_at', type: btree, note: 'CREATE INDEX idx_category_created_at ON public.category USING btree (created_at)']
    "is_active" [name: 'idx_category_is_active', type: btree, note: 'CREATE INDEX idx_category_is_active ON public.category USING btree (is_active) WHERE (is_deleted = false)']
    "name" [name: 'idx_category_name_active', type: btree, note: 'CREATE UNIQUE INDEX idx_category_name_active ON public.category USING btree (name) WHERE (is_deleted = false)']
    "parent_id" [name: 'idx_category_parent', type: btree, note: 'CREATE INDEX idx_category_parent ON public.category USING btree (parent_id) WHERE (is_deleted = false)']
  }
}

Table "contact_info" {
  "contact_id" serial [not null]
  "user_id" integer [not null]
  "full_name" varchar(100) [not null]
  "phone_number" varchar(15) [not null]
  "address" varchar(255) [not null]
  "province" varchar(100)
  "district" varchar(100)
  "ward" varchar(100)
  "is_default" boolean [not null, default: `false`]
  "is_deleted" boolean [not null, default: `false`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp

  indexes {
    "contact_id" [name: 'contact_info_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX contact_info_pkey ON public.contact_info USING btree (contact_id)']
    "is_default" [name: 'idx_contact_info_default', type: btree, note: 'CREATE INDEX idx_contact_info_default ON public.contact_info USING btree (is_default) WHERE (is_deleted = false)']
    "user_id" [name: 'idx_contact_info_user', type: btree, note: 'CREATE INDEX idx_contact_info_user ON public.contact_info USING btree (user_id)']
  }
}

Table "distributed_installation" {
  "singleton" boolean [not null, default: `true`]
  "version" integer [not null]
  "source_sha256" text [not null]
  "fixture_version" integer [not null]

  checks {
    `singleton` [name: 'distributed_installation_singleton_check']
  }

  indexes {
    "singleton" [name: 'distributed_installation_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX distributed_installation_pkey ON public.distributed_installation USING btree (singleton)']
  }
}

Table "etl_outbox" {
  "event_id" bigserial [not null]
  "source_table" text [not null]
  "source_key" jsonb [not null]
  "entity_type" text [not null]
  "entity_key" jsonb [not null]
  "operation" text [not null]
  "created_at" timestamptz [not null, default: `clock_timestamp()`]
  "available_at" timestamptz [not null, default: `clock_timestamp()`]
  "status" text [not null, default: `'pending'::text`]
  "attempts" integer [not null, default: `0`]
  "processed_at" timestamptz
  "last_error_code" varchar(80)
  "last_run_id" uuid [note: 'Không có FOREIGN KEY tới etl_runs.']

  checks {
    `(entity_type = ANY (ARRAY['product'::text, 'order'::text, 'review'::text, 'system_log'::text, 'violation_log'::text, 'contact'::text]))` [name: 'etl_outbox_entity_type_check']
    `(operation = ANY (ARRAY['INSERT'::text, 'UPDATE'::text, 'DELETE'::text]))` [name: 'etl_outbox_operation_check']
    `(status = ANY (ARRAY['pending'::text, 'done'::text, 'dead'::text]))` [name: 'etl_outbox_status_check']
    `(attempts >= 0)` [name: 'etl_outbox_attempts_check']
  }

  indexes {
    "event_id" [name: 'etl_outbox_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX etl_outbox_pkey ON public.etl_outbox USING btree (event_id)']
    ("entity_type", "entity_key", "event_id") [name: 'idx_etl_outbox_entity_pending', type: btree, note: 'CREATE INDEX idx_etl_outbox_entity_pending ON public.etl_outbox USING btree (entity_type, entity_key, event_id) WHERE (status <> \'done\'::text)']
    ("available_at", "event_id") [name: 'idx_etl_outbox_pending', type: btree, note: 'CREATE INDEX idx_etl_outbox_pending ON public.etl_outbox USING btree (available_at, event_id) WHERE (status = ANY (ARRAY[\'pending\'::text, \'dead\'::text]))']
    ("event_id", "available_at") [name: 'idx_etl_outbox_pending_event', type: btree, note: 'CREATE INDEX idx_etl_outbox_pending_event ON public.etl_outbox USING btree (event_id, available_at) WHERE (status = ANY (ARRAY[\'pending\'::text, \'dead\'::text]))']
  }
}

Table "etl_runs" {
  "run_id" uuid [not null]
  "mode" text [not null]
  "started_at" timestamptz [not null, default: `clock_timestamp()`]
  "ended_at" timestamptz
  "status" text [not null, default: `'running'::text`]
  "rows_in" bigint [not null, default: `0`]
  "rows_out" bigint [not null, default: `0`]
  "errors" integer [not null, default: `0`]
  "details" jsonb [not null, default: `'{}'::jsonb`]

  indexes {
    "run_id" [name: 'etl_runs_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX etl_runs_pkey ON public.etl_runs USING btree (run_id)']
    "ended_at" [name: 'idx_etl_runs_aggregate_success', type: btree, note: 'CREATE INDEX idx_etl_runs_aggregate_success ON public.etl_runs USING btree (ended_at DESC) WHERE ((status = \'success\'::text) AND (details ? \'aggregate\'::text))']
    "started_at" [name: 'idx_etl_runs_started', type: btree, note: 'CREATE INDEX idx_etl_runs_started ON public.etl_runs USING btree (started_at DESC)']
  }
}

Table "etl_state" {
  "name" text [not null]
  "value" jsonb [not null]
  "updated_at" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    "name" [name: 'etl_state_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX etl_state_pkey ON public.etl_state USING btree (name)']
  }
}

Table "etl_time_origin" {
  "source_table" text [not null]
  "source_key" jsonb [not null]
  "field_name" text [not null]
  "source_value" timestamp [not null]
  "source_zone" text [not null]
  "recorded_at" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    ("source_table", "source_key", "field_name") [name: 'etl_time_origin_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX etl_time_origin_pkey ON public.etl_time_origin USING btree (source_table, source_key, field_name)']
  }
}

Table "media_deletions" {
  "deletion_id" bigserial [not null]
  "url_path" text [not null]
  "status" text [not null, default: `'pending'::text`]
  "attempts" integer [not null, default: `0`]
  "available_at" timestamptz [not null, default: `clock_timestamp()`]
  "created_at" timestamptz [not null, default: `clock_timestamp()`]
  "processed_at" timestamptz
  "last_error_code" varchar(80)

  checks {
    `(url_path ~~ '/media/%'::text)` [name: 'media_deletions_url_path_check']
    `(status = ANY (ARRAY['pending'::text, 'done'::text]))` [name: 'media_deletions_status_check']
  }

  indexes {
    ("available_at", "deletion_id") [name: 'idx_media_deletions_due', type: btree, note: 'CREATE INDEX idx_media_deletions_due ON public.media_deletions USING btree (available_at, deletion_id) WHERE (status = \'pending\'::text)']
    "deletion_id" [name: 'media_deletions_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX media_deletions_pkey ON public.media_deletions USING btree (deletion_id)']
    "url_path" [name: 'media_deletions_url_path_key', unique, type: btree, note: 'CREATE UNIQUE INDEX media_deletions_url_path_key ON public.media_deletions USING btree (url_path)']
  }
}

Table "order" {
  "order_id" serial [not null]
  "buyer_id" integer [not null]
  "contact_id" integer [not null]
  "payment_method_id" integer [not null]
  "voucher_id" integer
  "order_date" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "total_amount" numeric(18,2) [not null]
  "shipping_fee" numeric(18,2) [default: `0`]
  "discount_amount" numeric(18,2) [default: `0`]
  "final_amount" numeric(18,2) [not null]
  "order_status" smallint [not null, default: `0`]
  "shipping_address" text
  "tracking_number" varchar(100)
  "notes" text
  "is_deleted" boolean [not null, default: `false`]

  checks {
    `(order_status = ANY (ARRAY[0, 1, 2, 3, 4]))` [name: 'order_order_status_check']
  }

  indexes {
    "voucher_id" [name: 'idx_order_voucher_lookup', type: btree, note: 'CREATE INDEX idx_order_voucher_lookup ON ONLY public."order" USING btree (voucher_id)']
    "buyer_id" [name: 'order_day4_new_buyer_id_idx', type: btree, note: 'CREATE INDEX order_day4_new_buyer_id_idx ON ONLY public."order" USING btree (buyer_id) WHERE (is_deleted = false)']
    ("buyer_id", "order_date") [name: 'order_day4_new_buyer_id_order_date_idx', type: btree, note: 'CREATE INDEX order_day4_new_buyer_id_order_date_idx ON ONLY public."order" USING btree (buyer_id, order_date DESC) WHERE (is_deleted = false)']
    "order_date" [name: 'order_day4_new_order_date_idx', type: btree, note: 'CREATE INDEX order_day4_new_order_date_idx ON ONLY public."order" USING btree (order_date) WHERE (is_deleted = false)']
    "order_status" [name: 'order_day4_new_order_status_idx', type: btree, note: 'CREATE INDEX order_day4_new_order_status_idx ON ONLY public."order" USING btree (order_status) WHERE (is_deleted = false)']
    "order_id" [name: 'order_day4_new_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX order_day4_new_pkey ON ONLY public."order" USING btree (order_id)']
  }

  Note: 'PARTITION BY HASH (order_id). Các partition order_h0..order_h3, MODULUS 4; PK(order_id) và FK được giữ. final_amount là cột thường NOT NULL, không phải generated column; SQL không có CHECK cho công thức tổng tiền.'
}

Table "order_detail" {
  "order_detail_id" serial [not null]
  "order_id" integer [not null]
  "product_id" integer [not null]
  "quantity" integer [not null]
  "price_at_purchase" numeric(18,2) [not null]
  "subtotal" numeric(18,2) [not null]

  checks {
    `(quantity > 0)` [name: 'order_detail_quantity_check']
  }

  indexes {
    "order_id" [name: 'idx_order_detail_order', type: btree, note: 'CREATE INDEX idx_order_detail_order ON public.order_detail USING btree (order_id)']
    ("product_id", "order_id") [name: 'idx_order_detail_product_order', type: btree, note: 'CREATE INDEX idx_order_detail_product_order ON public.order_detail USING btree (product_id, order_id)']
    "order_detail_id" [name: 'order_detail_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX order_detail_pkey ON public.order_detail USING btree (order_detail_id)']
  }
}

Table "payment_method" {
  "payment_method_id" serial [not null]
  "method_name" varchar(50) [not null]
  "is_online" boolean [not null]
  "is_deleted" boolean [not null, default: `false`]

  indexes {
    "method_name" [name: 'payment_method_method_name_key', unique, type: btree, note: 'CREATE UNIQUE INDEX payment_method_method_name_key ON public.payment_method USING btree (method_name)']
    "payment_method_id" [name: 'payment_method_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX payment_method_pkey ON public.payment_method USING btree (payment_method_id)']
  }
}

Table "product" {
  "product_id" serial [not null]
  "seller_id" integer [not null]
  "category_id" integer [not null]
  "title" varchar(255) [not null]
  "description" text
  "price" numeric(18,2) [not null]
  "quantity" integer [not null]
  "view_count" integer [not null, default: `0`]
  "video_url" varchar(500)
  "status" smallint [not null, default: `0`]
  "reject_reason" varchar(500)
  "approved_by" integer
  "is_deleted" boolean [not null, default: `false`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp
  "sold_at" timestamp
  "weight_grams" integer
  "dimensions" varchar(50)
  "condition_rating" smallint
  "warranty_months" integer [default: `0`]
  "transfer_method" smallint [not null, default: `1`]
  "site_id" text [not null, default: `local_site()`]

  checks {
    `(price >= (0)::numeric)` [name: 'product_price_check']
    `(quantity >= 0)` [name: 'product_quantity_check']
    `(status = ANY (ARRAY[0, 1, 2, 3]))` [name: 'product_status_check']
    `((condition_rating >= 1) AND (condition_rating <= 10))` [name: 'product_condition_rating_check']
    `(transfer_method = ANY (ARRAY[1, 2]))` [name: 'product_transfer_method_check']
    `(site_id = ANY (ARRAY['A'::text, 'B'::text]))` [name: 'product_site_id_check']
  }

  indexes {
    ("category_id", "created_at") [name: 'idx_product_catalogue', type: btree, note: 'CREATE INDEX idx_product_catalogue ON public.product USING btree (category_id, created_at DESC) WHERE ((status = 1) AND (is_deleted = false))']
    "category_id" [name: 'idx_product_category', type: btree, note: 'CREATE INDEX idx_product_category ON public.product USING btree (category_id) WHERE (is_deleted = false)']
    "created_at" [name: 'idx_product_created_at', type: btree, note: 'CREATE INDEX idx_product_created_at ON public.product USING btree (created_at) WHERE (is_deleted = false)']
    "description" [name: 'idx_product_description_trgm', note: 'CREATE INDEX idx_product_description_trgm ON public.product USING gin (description gin_trgm_ops) WHERE ((status = 1) AND (is_deleted = false))']
    "price" [name: 'idx_product_price', type: btree, note: 'CREATE INDEX idx_product_price ON public.product USING btree (price) WHERE (is_deleted = false)']
    "seller_id" [name: 'idx_product_seller', type: btree, note: 'CREATE INDEX idx_product_seller ON public.product USING btree (seller_id) WHERE (is_deleted = false)']
    "status" [name: 'idx_product_status', type: btree, note: 'CREATE INDEX idx_product_status ON public.product USING btree (status) WHERE (is_deleted = false)']
    `to_tsvector('english'::regconfig, title::text)` [name: 'idx_product_title', note: 'CREATE INDEX idx_product_title ON public.product USING gin (to_tsvector(\'english\'::regconfig, (title)::text)) WHERE (is_deleted = false)']
    "title" [name: 'idx_product_title_trgm', note: 'CREATE INDEX idx_product_title_trgm ON public.product USING gin (title gin_trgm_ops) WHERE ((status = 1) AND (is_deleted = false))']
    ("created_at", "product_id") [name: 'idx_product_visible_date_id', type: btree, note: 'CREATE INDEX idx_product_visible_date_id ON public.product USING btree (created_at DESC, product_id) WHERE ((status = 1) AND (is_deleted = false))']
    "product_id" [name: 'product_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX product_pkey ON public.product USING btree (product_id)']
  }
}

Table "product_image" {
  "image_id" serial [not null]
  "product_id" integer [not null]
  "image_url" varchar(500) [not null]
  "alt_text" varchar(255)
  "is_primary" boolean [not null, default: `false`]
  "display_order" integer [not null, default: `0`]
  "uploaded_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "content_type" varchar(100)
  "size_bytes" bigint

  checks {
    `(size_bytes >= 0)` [name: 'product_image_size_bytes_check']
  }

  indexes {
    "product_id" [name: 'idx_product_image_product', type: btree, note: 'CREATE INDEX idx_product_image_product ON public.product_image USING btree (product_id)']
    "image_url" [name: 'idx_product_image_url', type: btree, note: 'CREATE INDEX idx_product_image_url ON public.product_image USING btree (image_url)']
    "image_id" [name: 'product_image_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX product_image_pkey ON public.product_image USING btree (image_id)']
  }
}

Table "report_daily_sales" {
  "report_date" date [not null]
  "seller_id" integer [not null, note: 'Không có FOREIGN KEY trong SQL.']
  "category_id" integer [not null, note: 'Không có FOREIGN KEY trong SQL.']
  "orders_count" bigint [not null]
  "item_quantity" bigint [not null]
  "gross_sales_vnd" numeric(30,0) [not null]
  "refreshed_at" timestamptz [not null]
  "run_id" uuid [not null, note: 'Không có FOREIGN KEY trong SQL.']

  indexes {
    ("report_date", "seller_id", "category_id") [name: 'report_daily_sales_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX report_daily_sales_pkey ON public.report_daily_sales USING btree (report_date, seller_id, category_id)']
  }
}

Table "review" {
  "review_id" serial [not null]
  "product_id" integer [not null]
  "buyer_id" integer [not null]
  "rating" smallint [not null]
  "title" varchar(255)
  "content" text
  "is_verified_purchase" boolean [not null, default: `false`]
  "helpful_count" integer [not null, default: `0`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp
  "is_deleted" boolean [not null, default: `false`]

  checks {
    `((rating >= 0) AND (rating <= 5))` [name: 'review_rating_check']
  }

  indexes {
    "buyer_id" [name: 'idx_review_buyer', type: btree, note: 'CREATE INDEX idx_review_buyer ON public.review USING btree (buyer_id)']
    "product_id" [name: 'idx_review_product', type: btree, note: 'CREATE INDEX idx_review_product ON public.review USING btree (product_id)']
    "rating" [name: 'idx_review_rating', type: btree, note: 'CREATE INDEX idx_review_rating ON public.review USING btree (rating)']
    "review_id" [name: 'review_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX review_pkey ON public.review USING btree (review_id)']
  }
}

Table "role" {
  "role_id" serial [not null]
  "role_name" varchar(50) [not null]
  "description" varchar(255)
  "is_deleted" boolean [not null, default: `false`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp

  indexes {
    "created_at" [name: 'idx_role_created_at', type: btree, note: 'CREATE INDEX idx_role_created_at ON public.role USING btree (created_at)']
    "role_name" [name: 'idx_role_name', type: btree, note: 'CREATE INDEX idx_role_name ON public.role USING btree (role_name) WHERE (is_deleted = false)']
    "role_id" [name: 'role_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX role_pkey ON public.role USING btree (role_id)']
    "role_name" [name: 'role_role_name_key', unique, type: btree, note: 'CREATE UNIQUE INDEX role_role_name_key ON public.role USING btree (role_name)']
  }
}

Table "schema_migrations" {
  "version" varchar(3) [not null]
  "applied_at" timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  "checksum" character(64) [not null]

  indexes {
    "version" [name: 'schema_migrations_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX schema_migrations_pkey ON public.schema_migrations USING btree (version)']
  }
}

Table "seller_site" {
  "seller_id" integer [not null]
  "site_id" text [not null]

  checks {
    `(site_id = ANY (ARRAY['A'::text, 'B'::text]))` [name: 'seller_site_site_id_check']
  }

  indexes {
    "seller_id" [name: 'seller_site_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX seller_site_pkey ON public.seller_site USING btree (seller_id)']
    ("seller_id", "site_id") [name: 'seller_site_seller_id_site_id_key', unique, type: btree, note: 'CREATE UNIQUE INDEX seller_site_seller_id_site_id_key ON public.seller_site USING btree (seller_id, site_id)']
  }
}

Table "shopping_cart" {
  "cart_id" serial [not null]
  "user_id" integer [not null]
  "last_updated" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    "cart_id" [name: 'shopping_cart_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX shopping_cart_pkey ON public.shopping_cart USING btree (cart_id)']
    "user_id" [name: 'shopping_cart_user_id_key', unique, type: btree, note: 'CREATE UNIQUE INDEX shopping_cart_user_id_key ON public.shopping_cart USING btree (user_id)']
  }

  Note: 'UNIQUE(user_id): mỗi user có tối đa một giỏ hàng; FK không bắt buộc user phải có giỏ.'
}

Table "shopping_cart_item" {
  "cart_item_id" serial [not null]
  "cart_id" integer [not null]
  "product_id" integer [not null]
  "quantity" integer [not null]
  "added_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `(quantity > 0)` [name: 'shopping_cart_item_quantity_check']
  }

  indexes {
    "cart_id" [name: 'idx_shopping_cart_item_cart', type: btree, note: 'CREATE INDEX idx_shopping_cart_item_cart ON public.shopping_cart_item USING btree (cart_id)']
    "product_id" [name: 'idx_shopping_cart_item_product', type: btree, note: 'CREATE INDEX idx_shopping_cart_item_product ON public.shopping_cart_item USING btree (product_id)']
    "cart_item_id" [name: 'shopping_cart_item_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX shopping_cart_item_pkey ON public.shopping_cart_item USING btree (cart_item_id)']
    ("cart_id", "product_id") [name: 'uq_cart_product', unique, type: btree, note: 'CREATE UNIQUE INDEX uq_cart_product ON public.shopping_cart_item USING btree (cart_id, product_id)']
  }
}

Table "site_config" {
  "singleton" boolean [not null, default: `true`]
  "site_id" text [not null]
  "id_remainder" smallint [not null]

  checks {
    `singleton` [name: 'site_config_singleton_check']
    `(site_id = ANY (ARRAY['A'::text, 'B'::text]))` [name: 'site_config_site_id_check']
    `(((site_id = 'A'::text) AND (id_remainder = 1)) OR ((site_id = 'B'::text) AND (id_remainder = 0)))` [name: 'site_config_check']
  }

  indexes {
    "singleton" [name: 'site_config_pkey', pk, type: btree, note: 'CREATE UNIQUE INDEX site_config_pkey ON public.site_config USING btree (singleton)']
    "site_id" [name: 'site_config_site_id_key', unique, type: btree, note: 'CREATE UNIQUE INDEX site_config_site_id_key ON public.site_config USING btree (site_id)']
  }
}

Table "system_feedback" {

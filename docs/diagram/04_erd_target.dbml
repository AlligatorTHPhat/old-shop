// Day 4 implemented schema. Physical DDL is authoritative in database/04_migrations.
Project oldshop_day4 {
  database_type: 'PostgreSQL'
  Note: 'Day 4 logical parent tables; physical partitions in SQL. users_full is a read-only join view, omitted here.'
}

Table user_core {
  user_id serial [pk, not null]
  username varchar(50) [unique, not null]
  email varchar(100) [unique, not null]
  is_active bool [not null, default: true]
  is_deleted bool [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp
  last_login timestamp [note: 'ghi mỗi lần login']
  email_verified bool [not null, default: false]
  trust_score decimal(5,2) [default: 0.0]
}

Table user_profile {
  user_id int [pk, not null, ref: > user_core.user_id]
  full_name varchar(100) [not null]
  phone_number varchar(15)
  address varchar(255)
  avatar_url varchar(500) [note: '/media/users/...']
}

Table user_secret {
  user_id int [pk, not null, ref: > user_core.user_id]
  password_hash varchar(255) [not null, note: 'Bcrypt; seed SQL cost 8, app uses passlib']
  random_key varchar(64) [unique, not null]
  email_verification_token varchar(255)
  password_reset_token varchar(255) [note: 'token hoặc OTP']
  password_reset_expires timestamp
}

Table user_wallet {
  user_id int [pk, not null, ref: > user_core.user_id]
  balance decimal(18,4) [not null, default: 10000000.00, note: 'ví, default 10,000,000']
}

Table role {
  role_id serial [pk, not null]
  role_name varchar(50) [unique, not null, note: 'Admin/Mod/User']
  description varchar(255)
  is_deleted bool [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

}

Table user_role {
  user_id int [not null]
  role_id int [not null]

  indexes {
    (user_id, role_id) [pk, name: 'user_role_pkey']
  }
}

Table category {
  category_id serial [pk, not null]
  name varchar(100) [unique, not null]
  description text
  parent_id int [note: 'cây danh mục']
  is_active bool [not null, default: true]
  is_deleted bool [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

}

Table product {
  product_id serial [pk, not null]
  seller_id int [not null]
  category_id int [not null]
  title varchar(255) [not null]
  description text [note: 'Current PG TEXT; Mongo is a future proposal']
  price decimal(18,2) [not null]
  quantity int [not null, note: 'tồn kho – nguồn sự thật PG']
  view_count int [not null, default: 0, note: 'ghi nóng']
  video_url varchar(500) [note: 'link Drive ngoài']
  status smallint [not null, default: 0, note: '0..3']
  reject_reason varchar(500)
  approved_by int
  is_deleted bool [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [note: 'SQL trigger only when quantity changes; ORM also uses onupdate']
  sold_at timestamp
  weight_grams int [note: 'Current PG integer']
  dimensions varchar(50) [note: 'Current PG string, e.g. 35x24x2 cm']
  condition_rating smallint [note: 'Current PG grade 1..10']
  warranty_months int [default: 0, note: 'Current PG integer; default 0']
  transfer_method smallint [not null, default: 1, note: '1 ship / 2 gặp mặt']

  checks {
    `((condition_rating >= 1) AND (condition_rating <= 10))` [name: 'product_condition_rating_check']
    `(price >= (0)::numeric)` [name: 'product_price_check']
    `(quantity >= 0)` [name: 'product_quantity_check']
    `(status = ANY (ARRAY[0, 1, 2, 3]))` [name: 'product_status_check']
    `(transfer_method = ANY (ARRAY[1, 2]))` [name: 'product_transfer_method_check']
  }

}

Table product_image {
  image_id serial [pk, not null]
  product_id int [not null, note: 'ON DELETE CASCADE']
  image_url varchar(500) [not null, note: '/media/... -> MinIO key']
  content_type varchar(100)
  size_bytes bigint [note: 'nullable until stat backfill; nonnegative']
  alt_text varchar(255)
  is_primary bool [not null, default: false]
  display_order int [not null, default: 0]
  uploaded_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

}

Table voucher {
  voucher_id serial [pk, not null]
  code varchar(50) [unique, not null]
  description varchar(255)
  discount_type smallint [not null, default: 0, note: '0 fixed / 1 percent']
  discount_value decimal(18,2) [not null]
  max_usage int
  usage_count int [not null, default: 0, note: 'W khi dùng']
  min_order_amount decimal(18,2)
  valid_from timestamp [not null]
  valid_to timestamp [not null]
  is_active bool [not null, default: true]
  is_deleted bool [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

}

Table payment_method {
  payment_method_id serial [pk, not null]
  method_name varchar(50) [unique, not null]
  is_online bool [not null]
  is_deleted bool [not null, default: false]
}

Table contact_info {
  contact_id serial [pk, not null]
  user_id int [not null]
  full_name varchar(100) [not null]
  phone_number varchar(15) [not null]
  address varchar(255) [not null]
  province varchar(100) [note: 'khóa suy ra vùng']
  district varchar(100)
  ward varchar(100)
  is_default bool [not null, default: false]
  is_deleted bool [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp

}

Table order {
  Note: 'HASH(order_id), partitions order_h0..order_h3. PK/order FK unchanged.'
  order_id serial [pk, not null]
  buyer_id int [not null]
  contact_id int [not null, note: 'FK does not enforce ownership; API validates buyer contact']
  payment_method_id int [not null]
  voucher_id int
  order_date timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'Current timestamp without time zone; no updated_at column']
  total_amount decimal(18,2) [not null]
  shipping_fee decimal(18,2) [default: 0]
  discount_amount decimal(18,2) [default: 0]
  final_amount decimal(18,2) [not null]
  order_status smallint [not null, default: 0, note: '0..4']
  shipping_address text [note: 'snapshot địa chỉ']
  tracking_number varchar(100) [note: 'App initially stores receiver phone, later tracking code; PII']
  notes text [note: 'ghi chú tự do']
  is_deleted bool [not null, default: false]

  checks {
    `(order_status = ANY (ARRAY[0, 1, 2, 3, 4]))` [name: 'order_order_status_check']
  }

}

Table order_detail {
  order_detail_id serial [pk, not null]
  order_id int [not null]
  product_id int [not null]
  quantity int [not null]
  price_at_purchase decimal(18,2) [not null, note: 'snapshot giá']
  subtotal decimal(18,2) [not null]

  checks {
    `(quantity > 0)` [name: 'order_detail_quantity_check']
  }

}

Table transaction {
  transaction_id serial [pk, not null]
  order_id int [not null, note: 'ON DELETE CASCADE']
  user_id int [not null]
  payment_method_id int [not null]
  amount decimal(18,4) [not null]
  balance_before decimal(18,4) [default: 0.0000]
  balance_after decimal(18,4) [default: 0.0000]
  transaction_status smallint [not null, default: 0, note: 'No CHECK; SQL comment/seed: 3=Fraud,4=Failed; Python: FAILED=3']
  fraud_score decimal(5,2) [default: 0.00]
  reference_number varchar(100) [unique, note: 'UNIQUE but nullable in SQL']
  provider_transaction_id varchar(100) [note: 'PayPal capture id']
  address text
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  checks {
    `(amount >= (0)::numeric)` [name: 'transaction_amount_check']
  }

}

Table shopping_cart {
  cart_id serial [pk, not null]
  user_id int [unique, not null, note: 'UNIQUE: each user has zero or one cart']
  last_updated timestamp [not null, default: `CURRENT_TIMESTAMP`, note: 'W nóng']
}

Table shopping_cart_item {
  cart_item_id serial [pk, not null]
  cart_id int [not null]
  product_id int [not null]
  quantity int [not null]
  added_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `(quantity > 0)` [name: 'shopping_cart_item_quantity_check']
  }

  indexes {
    (cart_id, product_id) [unique, name: 'uq_cart_product']
  }
}

Table review {
  review_id serial [pk, not null]
  product_id int [not null]
  buyer_id int [not null]
  rating smallint [not null, note: '0 = báo cáo vi phạm']
  title varchar(255)
  content text [note: 'văn bản tự do']
  is_verified_purchase bool [not null, default: false]
  helpful_count int [not null, default: 0]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp
  is_deleted bool [not null, default: false]

  checks {
    `((rating >= 0) AND (rating <= 5))` [name: 'review_rating_check']
  }

}

Table system_log {
  Note: 'RANGE(created_at), monthly plus DEFAULT. Timestamps unchanged.'
  log_id bigserial [not null, note: 'BIGSERIAL; sequence allocation is not commit order']
  user_id int
  action varchar(100) [not null]
  resource_type varchar(50)
  resource_id int
  details text [note: 'text tự do']
  ip_address varchar(45) [note: 'IP client DB, không phải end-user']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (log_id, created_at) [pk]
  }
}

Table violation_log {
  log_id serial [pk, not null]
  user_id int [not null, note: 'đối tượng bị xử lý (không có actor)']
  reason varchar(500) [not null]
  action_taken varchar(50) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

}

Table system_feedback {
  feedback_id serial [pk, not null]
  user_id int [note: 'ON DELETE SET NULL']
  guest_email varchar(255)
  subject varchar(200) [not null]
  content text [not null, note: 'form liên hệ']
  status smallint [default: 0, note: '0..2']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

}

Ref category_parent_id_fkey: category.parent_id > category.category_id [delete: no action, update: no action]
Ref contact_info_user_id_fkey: contact_info.user_id > user_core.user_id [delete: no action, update: no action]
Ref order_buyer_id_fkey: order.buyer_id > user_core.user_id [delete: no action, update: no action]
Ref order_contact_id_fkey: order.contact_id > contact_info.contact_id [delete: no action, update: no action]
Ref order_payment_method_id_fkey: order.payment_method_id > payment_method.payment_method_id [delete: no action, update: no action]
Ref order_voucher_id_fkey: order.voucher_id > voucher.voucher_id [delete: no action, update: no action]
Ref order_detail_order_id_fkey: order_detail.order_id > order.order_id [delete: no action, update: no action]
Ref order_detail_product_id_fkey: order_detail.product_id > product.product_id [delete: no action, update: no action]
Ref product_approved_by_fkey: product.approved_by > user_core.user_id [delete: no action, update: no action]
Ref product_category_id_fkey: product.category_id > category.category_id [delete: no action, update: no action]
Ref product_seller_id_fkey: product.seller_id > user_core.user_id [delete: no action, update: no action]
Ref product_image_product_id_fkey: product_image.product_id > product.product_id [delete: cascade, update: no action]
Ref review_buyer_id_fkey: review.buyer_id > user_core.user_id [delete: no action, update: no action]
Ref review_product_id_fkey: review.product_id > product.product_id [delete: no action, update: no action]
Ref shopping_cart_user_id_fkey: user_core.user_id - shopping_cart.user_id [delete: no action, update: no action]
Ref shopping_cart_item_cart_id_fkey: shopping_cart_item.cart_id > shopping_cart.cart_id [delete: no action, update: no action]
Ref shopping_cart_item_product_id_fkey: shopping_cart_item.product_id > product.product_id [delete: no action, update: no action]
Ref system_feedback_user_id_fkey: system_feedback.user_id > user_core.user_id [delete: set null, update: no action]
Ref system_log_user_id_fkey: system_log.user_id > user_core.user_id [delete: no action, update: no action]
Ref transaction_order_id_fkey: transaction.order_id > order.order_id [delete: cascade, update: no action]
Ref transaction_payment_method_id_fkey: transaction.payment_method_id > payment_method.payment_method_id [delete: no action, update: no action]
Ref transaction_user_id_fkey: transaction.user_id > user_core.user_id [delete: no action, update: no action]
Ref user_role_role_id_fkey: user_role.role_id > role.role_id [delete: no action, update: no action]
Ref user_role_user_id_fkey: user_role.user_id > user_core.user_id [delete: no action, update: no action]
Ref violation_log_user_id_fkey: violation_log.user_id > user_core.user_id [delete: no action, update: no action]

    {
      "sql": "SELECT anon_1.product_product_id AS anon_1_product_product_id, anon_1.product_seller_id AS anon_1_product_seller_id, anon_1.product_category_id AS anon_1_product_category_id, anon_1.product_title AS anon_1_product_title, anon_1.product_description AS anon_1_product_description, anon_1.product_price AS anon_1_product_price, anon_1.product_quantity AS anon_1_product_quantity, anon_1.product_view_count AS anon_1_product_view_count, anon_1.product_video_url AS anon_1_product_video_url, anon_1.product_status AS anon_1_product_status, anon_1.product_reject_reason AS anon_1_product_reject_reason, anon_1.product_approved_by AS anon_1_product_approved_by, anon_1.product_is_deleted AS anon_1_product_is_deleted, anon_1.product_created_at AS anon_1_product_created_at, anon_1.product_updated_at AS anon_1_product_updated_at, anon_1.product_sold_at AS anon_1_product_sold_at, anon_1.product_weight_grams AS anon_1_product_weight_grams, anon_1.product_dimensions AS anon_1_product_dimensions, anon_1.product_condition_rating AS anon_1_product_condition_rating, anon_1.product_warranty_months AS anon_1_product_warranty_months, anon_1.product_transfer_method AS anon_1_product_transfer_method, product_image_1.image_id AS product_image_1_image_id, product_image_1.product_id AS product_image_1_product_id, product_image_1.image_url AS product_image_1_image_url, product_image_1.alt_text AS product_image_1_alt_text, product_image_1.content_type AS product_image_1_content_type, product_image_1.size_bytes AS product_image_1_size_bytes, product_image_1.is_primary AS product_image_1_is_primary, product_image_1.display_order AS product_image_1_display_order, product_image_1.uploaded_at AS product_image_1_uploaded_at \nFROM (SELECT product.product_id AS product_product_id, product.seller_id AS product_seller_id, product.category_id AS product_category_id, product.title AS product_title, product.description AS product_description, product.price AS product_price, product.quantity AS product_quantity, product.view_count AS product_view_count, product.video_url AS product_video_url, product.status AS product_status, product.reject_reason AS product_reject_reason, product.approved_by AS product_approved_by, product.is_deleted AS product_is_deleted, product.created_at AS product_created_at, product.updated_at AS product_updated_at, product.sold_at AS product_sold_at, product.weight_grams AS product_weight_grams, product.dimensions AS product_dimensions, product.condition_rating AS product_condition_rating, product.warranty_months AS product_warranty_months, product.transfer_method AS product_transfer_method \nFROM product JOIN category ON product.category_id = category.category_id \nWHERE product.status = %(status_1)s AND product.is_deleted = false AND category.is_deleted = false AND category.is_active = true ORDER BY product.created_at DESC, product.product_id ASC \n LIMIT %(param_1)s OFFSET %(param_2)s) AS anon_1 LEFT OUTER JOIN product_image AS product_image_1 ON anon_1.product_product_id = product_image_1.product_id ORDER BY anon_1.product_created_at DESC, anon_1.product_product_id ASC",
      "parameters": {
        "status_1": 1,
        "param_1": 100,
        "param_2": 0
      }
    }

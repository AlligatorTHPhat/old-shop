# Generated credentials live in deploy/sites/.env (ignored, mode 600).
POSTGRES_IMAGE=postgres:16-alpine
SITE_A_DB_NAME=oldshop_1
SITE_B_DB_NAME=oldshop_2
SITE_A_PORT=56431
SITE_B_PORT=56432
SITE_A_BIND_IP=127.0.0.1
SITE_B_BIND_IP=127.0.0.1
SITES_SUBNET=172.29.82.0/24
SITE_A_VIRTUAL_IP=172.29.82.11
SITE_B_VIRTUAL_IP=172.29.82.12
# Multi-host: set this to the LAN/VPN IP and published port of host B.
SITE_B_FDW_HOST=172.29.82.12
SITE_B_FDW_PORT=5432
# On two physical hosts: set to the actual source IP seen by PostgreSQL B.
SITE_B_READER_SOURCE_CIDR=172.29.82.11/32
CATALOGUE_VIRTUAL_IP=172.29.82.20
CATALOGUE_PORT=56480
SITE_A_ADMIN_PASSWORD=CHANGE_ME
SITE_B_ADMIN_PASSWORD=CHANGE_ME
SITE_A_WRITER_PASSWORD=CHANGE_ME
SITE_B_WRITER_PASSWORD=CHANGE_ME
SITE_A_READER_PASSWORD=CHANGE_ME
SITE_B_READER_PASSWORD=CHANGE_ME
SITE_A_GLOBAL_PASSWORD=CHANGE_ME
SITE_B_GLOBAL_PASSWORD=CHANGE_ME

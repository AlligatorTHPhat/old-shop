# Edge proxy: automatic HTTPS (Let's Encrypt) for the shop and the observability UIs.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

(common) {
	encode zstd gzip
	log {
		output stdout
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{$DOMAIN} {
	import common
	reverse_proxy frontend:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
}

# Grafana has its own login (GRAFANA_ADMIN_PASSWORD).
{$GRAFANA_DOMAIN} {
	import common
	reverse_proxy grafana:3000
}

# Kibana is only up in ELK mode; it is protected by basic auth in front of the Elastic login.
# Generate the hash with: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '<password>'
{$KIBANA_DOMAIN} {
	import common
	basic_auth {
		{$KIBANA_BASIC_AUTH_USER} {$KIBANA_BASIC_AUTH_HASH}
	}
	reverse_proxy kibana:5601
}

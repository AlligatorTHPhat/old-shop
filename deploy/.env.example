# Copy to deploy/.env on the VPS and fill in every CHANGE_ME. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

# ---------- Domains (DNS A records must point to the VPS) ----------
DOMAIN=shop.example.com
GRAFANA_DOMAIN=grafana.shop.example.com
KIBANA_DOMAIN=kibana.shop.example.com
ACME_EMAIL=you@example.com

# ---------- Images (pushed by .github/workflows/deploy.yml) ----------
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-username-in-lowercase
IMAGE_TAG=latest

# ---------- Log stack: loki (default, light) | elk (needs >= 4 GB RAM) ----------
LOG_STACK=loki

# ---------- Database ----------
DB_USER=oldshop
DB_PASSWORD=CHANGE_ME
DB_NAME=oldshop

# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=<tài khoản PostgreSQL>
# DB_PASSWORD=<mật khẩu>
# DB_NAME=oldshop

# MONGO_URI=<URI MongoDB server của bạn>
# MONGO_DB=oldshop

# ---------- Backend ----------
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://shop.example.com
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Gmail app password for OTP emails (leave empty to disable)
SMTP_USER=
SMTP_PASSWORD=

# PayPal sandbox/live credentials
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Google Apps Script contact relay (integrations/google-apps-script)
GAS_WEBHOOK_URL=
GAS_SHARED_SECRET=

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------- ELK (only used when LOG_STACK=elk) ----------
ELASTIC_PASSWORD=CHANGE_ME
KIBANA_SYSTEM_PASSWORD=CHANGE_ME
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM_xxxxxxxx
ES_HEAP=1g
KIBANA_BASIC_AUTH_USER=admin
# caddy hash-password output; the $ signs must be doubled ($$) in this file
KIBANA_BASIC_AUTH_HASH=

# ---------- Backups ----------
BACKUP_KEEP_DAYS=14

# Copy with: python3 deploy/scripts/prepare-data-env.py
# Generated .env.data is ignored by Git. Do not reuse these placeholders.
DB_USER=oldshop
DB_NAME=oldshop
DB_PASSWORD=CHANGE_ME
PG_REPLICATION_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
MONGO_ROOT_USER=oldshop_admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USER=oldshop_app
MONGO_APP_PASSWORD=CHANGE_ME
MONGO_DB=oldshop
MONGO_KEYFILE=CHANGE_ME
MINIO_ROOT_USER=oldshop_minio
MINIO_ROOT_PASSWORD=CHANGE_ME
# Day 3 will provision bucket-scoped application credentials.
MINIO_APP_ACCESS_KEY=oldshop_media
MINIO_APP_SECRET_KEY=CHANGE_ME
STORAGE_BACKEND=local
PG_PRIMARY_PORT=55432
PG_REPLICA_PORT=55433
BACKEND_PORT=58000
FRONTEND_PORT=58080
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
POSTGRES_IMAGE=postgres:16-alpine
MONGO_IMAGE=mongo:8.0.32
MINIO_IMAGE=quay.io/minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e

# Day 5: one ETL worker; daily deep reconciliation and manual full CLI.
ETL_POLL_SECONDS=60
ETL_BATCH_SIZE=100
ETL_MAX_ATTEMPTS=5

{
  "uid": "oldshop-logs",
  "title": "OldShop - Logs (Loki)",
  "tags": ["oldshop", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service", "type": "query", "label": "Service",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service", "type": 1, "stream": "" },
        "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search", "type": "textbox", "label": "Contains", "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Log volume by level",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum by (level) (count_over_time({service=~\"$service\"} [1m]))", "legendFormat": "{{level}}" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 2, "type": "logs", "title": "Backend errors",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service=\"backend\", level=~\"error|critical\"}" }],
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true }
    },
    {
      "id": 3, "type": "logs", "title": "All logs",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service=~\"$service\"} |= \"$search\"" }],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "id": 4, "type": "table", "title": "Slowest requests (last 15 min, from access log)",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "topk(15, max by (path) (max_over_time({service=\"backend\"} | json | duration_ms != \"\" | unwrap duration_ms [15m])))", "instant": true, "format": "table" }]
    }
  ]
}

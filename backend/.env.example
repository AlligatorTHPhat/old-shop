# Local development without Docker: copy to backend/.env, then `uvicorn app.main:app --reload`.
# Every variable is documented in app/core/config.py.

ENVIRONMENT=development
DEBUG=true
LOG_FORMAT=text

# Either a full URL...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oldshop
# ...or the parts:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=oldshop

# openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:4200

# Optional integrations (features degrade gracefully when empty)
SMTP_USER=
SMTP_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
GAS_WEBHOOK_URL=
GAS_SHARED_SECRET=

# Day 2 data infrastructure; local storage remains active until Day 3 integration.
# Host clients cannot resolve Compose-only Mongo replica hostnames; use the in-stack URI there.
MONGO_URI=
MONGO_DB=oldshop
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:59000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_PRODUCT_IMAGES=product-images
MINIO_BUCKET_USER_AVATARS=user-avatars
MINIO_BUCKET_ATTACHMENTS=attachments
# Optional replica read routing (Day 6); keep empty with the base stack.
PG_REPLICA_URL=
# Future FDW site, outside the one-host MVP.
PG_NODE_B_URL=

# Day 5 ETL worker (run as a separate process)
ETL_POLL_SECONDS=60
ETL_BATCH_SIZE=100
ETL_MAX_ATTEMPTS=5
ETL_BACKOFF_SECONDS=15

# Local development without Docker: copy to backend/.env, then `uvicorn app.main:app --reload`.
# Every variable is documented in app/core/config.py.

ENVIRONMENT=development
DEBUG=true
LOG_FORMAT=text

# Either a full URL...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oldshop
# ...or the parts:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=oldshop

# openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:4200

# Optional integrations (features degrade gracefully when empty)
SMTP_USER=
SMTP_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
GAS_WEBHOOK_URL=
GAS_SHARED_SECRET=
